{
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python",
      "config": {
        "buildCommand": "python scripts/build_model.py"
      }
    },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/app.py" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ],
  "functions": {
    "backend/app.py": { "maxDuration": 60 }
  }
}
